<mxfile host="app.diagrams.net" modified="2026-04-18T00:00:00.000Z" agent="GR46" version="24.0.0" type="device">
  <diagram id="cia-fw" name="CIA — Firewall rules">
    <mxGraphModel dx="1422" dy="754" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Matrice de règles pfSense — Site A &amp; Site B" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ks" value="FLOATING (prio 0)&#10;block out on wan source-alias KILLSWITCH_ACTIVE&#10;→ Effet : si alias non vide, tout trafic WAN bloqué" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wan" value="WAN (défaut block)&#10;&#10;pfsense-s1 : pass udp 1194 → wanip (OpenVPN server)&#10;pfsense-s2 : pass tcp 2222 → wanip NAT bastion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lan" value="LAN (défaut block)&#10;&#10;pass tcp 80,443 → any (egress Internet)&#10;pass udp 53 → pfSense (DNS)&#10;BLOCK LAN → ADMIN (segmentation stricte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="ADMIN (défaut block)&#10;&#10;pass tcp 22,443,8000 → LAN (management from ADMIN_NETS)&#10;pass tcp 22,2222 → bastion&#10;Accès à TOUT sauf trafic Internet non filtré" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vpn" value="OpenVPN pseudo-interface&#10;&#10;pass 10.10.0.0/24 ↔ 192.168.0.0/24&#10;pass 10.10.10.0/24 ↔ 192.168.10.0/24&#10;block any → VPN sauf les deux règles ci-dessus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="240" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alias" value="Aliases&#10;&#10;KILLSWITCH_ACTIVE (host) : vide par défaut&#10;ADMIN_NETS (network) : 10.10.10.0/24 192.168.10.0/24&#10;ELASTIC_HOSTS (host) : 10.10.0.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="Logging&#10;&#10;Toutes les règles block loggent (filterlog)&#10;Syslog remote → 10.10.0.30:5514 (Logstash)&#10;Indexation Kibana : cia-pfsense-*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
