---
# ansible-lint — configuration projet CIA / GR46.
# Doc : https://ansible.readthedocs.io/projects/lint/configuring/
#
# Politique : on lint le code (best-practices, FQCN, idempotence). Le
# `syntax-check` est délégué au job matrix dédié (workflow ansible.yml,
# job `syntax-check`) qui exécute `ansible-playbook --syntax-check`
# par site (siteA / siteB) avec le bon inventaire.
#
# Note importante : ansible-lint v24+ refuse `syntax-check` dans
# skip_list/warn_list (règle "unskippable"). On compte donc sur l'env
# ANSIBLE_ROLES_PATH + ANSIBLE_COLLECTIONS_PATH (set dans le workflow)
# pour que syntax-check trouve rôles & modules.

profile: moderate

exclude_paths:
  - .ansible/
  - .cache/
  - .git/
  - .github/
  - terraform/
  - secrets/

# Modules de collections externes — mockés en filet de sécurité pour le
# hook pre-commit (si réactivé un jour) et pour les environnements où la
# collection n'est pas (encore) installée.
mock_modules:
  - community.general.timezone
  - community.docker.docker_compose_v2
  - community.sops.load_vars
  - netbox.netbox.nb_inventory
  - pfsensible.core.pfsense_rule
  - pfsensible.core.pfsense_alias

# Rôles internes — mockés pour les environnements isolés. Le workflow CI
# définit ANSIBLE_ROLES_PATH=ansible/roles donc les vraies définitions
# sont chargées en priorité.
mock_roles:
  - common
  - filebeat
  - pfsense
  - openvpn
  - dns-forwarder
  - netbox
  - webapp
  - elasticsearch
  - kibana
  - logstash
  - bastion

# Règles désactivées avec justification.
# NOTE: `syntax-check` ne peut PAS être listé ici (unskippable depuis v24).
skip_list:
  - galaxy[no-changelog]   # rôles internes, pas de changelog Galaxy
  - meta-no-info           # rôles internes, pas publiés sur Galaxy

# Règles que l'on rétrograde de fatal à warning (politique projet).
warn_list:
  - experimental
  - fqcn-builtins          # déjà appliqué dans 95% du code, transition douce
  - role-name              # nos rôles utilisent des tirets (`dns-forwarder`)
