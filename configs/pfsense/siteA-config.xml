<?xml version="1.0"?>
<!--
    pfSense reference config export — Site A (on-prem)
    ==================================================
    Ce fichier est un snapshot lisible de la configuration pfSense Site A.
    Il est régénéré automatiquement par le rôle ansible `pfsense` (tâche
    "export pfSense config") et sert de preuve d'audit pour network_firewall,
    sec_hardening et killswitch.

    ATTENTION : les secrets (mots de passe, clefs privées) sont filtrés
    par le pipeline d'export — ne les committer JAMAIS en clair.
-->
<pfsense>
  <version>23.09</version>
  <system>
    <hostname>pfsense-s1</hostname>
    <domain>s1.lan</domain>
    <dnsserver>127.0.0.1</dnsserver>
    <timezone>Europe/Paris</timezone>
    <timeservers>fr.pool.ntp.org</timeservers>
  </system>

  <interfaces>
    <wan>
      <if>vtnet0</if>
      <ipaddr>dhcp</ipaddr>
      <enable/>
    </wan>
    <lan>
      <if>vtnet1</if>
      <ipaddr>10.10.0.1</ipaddr>
      <subnet>24</subnet>
      <enable/>
    </lan>
    <opt1>
      <if>vtnet2</if>
      <descr>ADMIN</descr>
      <ipaddr>10.10.10.1</ipaddr>
      <subnet>24</subnet>
      <enable/>
    </opt1>
  </interfaces>

  <!-- Alias KILLSWITCH_ACTIVE : toggled via API par ansible/playbooks/killswitch.yml -->
  <aliases>
    <alias>
      <name>KILLSWITCH_ACTIVE</name>
      <type>host</type>
      <descr>Flag killswitch : si non vide, bloque tout trafic WAN</descr>
      <address></address>
    </alias>
    <alias>
      <name>ADMIN_NETS</name>
      <type>network</type>
      <descr>Réseaux d'administration autorisés</descr>
      <address>10.10.10.0/24 192.168.10.0/24</address>
    </alias>
  </aliases>

  <!-- Règles de filtrage — ordre : floating (killswitch) → WAN → LAN → VPN -->
  <filter>
    <!-- Floating : killswitch WAN -->
    <rule>
      <type>block</type>
      <floating>yes</floating>
      <direction>out</direction>
      <interface>wan</interface>
      <source><any/></source>
      <destination><any/></destination>
      <source-alias>KILLSWITCH_ACTIVE</source-alias>
      <descr>KILLSWITCH — bloque toute sortie WAN si alias non vide</descr>
    </rule>

    <!-- WAN : bloquer par défaut, autoriser OpenVPN entrant -->
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>udp</protocol>
      <destination><network>wanip</network><port>1194</port></destination>
      <descr>OpenVPN server (Site B -> Site A)</descr>
    </rule>

    <!-- LAN : sortie web uniquement, pas d'admin direct -->
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <source><network>lan</network></source>
      <destination><any/></destination>
      <protocol>tcp</protocol>
      <destination-port>80 443</destination-port>
      <descr>LAN egress HTTP/HTTPS</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <source><network>lan</network></source>
      <destination><address>10.10.0.1</address></destination>
      <protocol>udp</protocol>
      <destination-port>53</destination-port>
      <descr>LAN -> pfSense DNS</descr>
    </rule>
    <rule>
      <type>block</type>
      <interface>lan</interface>
      <source><network>lan</network></source>
      <destination><network>opt1</network></destination>
      <descr>LAN ne voit PAS ADMIN (segmentation)</descr>
    </rule>

    <!-- ADMIN : accès SSH/HTTPS vers services -->
    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <source><alias>ADMIN_NETS</alias></source>
      <destination><network>lan</network></destination>
      <protocol>tcp</protocol>
      <destination-port>22 443 8000</destination-port>
      <descr>ADMIN -> LAN management</descr>
    </rule>

    <!-- VPN : autoriser s2 LAN vers s1 LAN explicitement -->
    <rule>
      <type>pass</type>
      <interface>openvpn</interface>
      <source><network>192.168.0.0/24</network></source>
      <destination><network>10.10.0.0/24</network></destination>
      <descr>Site B LAN -> Site A LAN (via tunnel)</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>openvpn</interface>
      <source><network>192.168.10.0/24</network></source>
      <destination><network>10.10.10.0/24</network></destination>
      <descr>Site B ADMIN -> Site A ADMIN (via tunnel)</descr>
    </rule>
  </filter>

  <!-- OpenVPN serveur -->
  <openvpn>
    <openvpn-server>
      <vpnid>1</vpnid>
      <description>CIA VPN Server (Site A)</description>
      <mode>p2p_tls</mode>
      <protocol>UDP4</protocol>
      <interface>wan</interface>
      <local_port>1194</local_port>
      <tunnel_network>172.16.0.0/30</tunnel_network>
      <remote_networks>192.168.0.0/24,192.168.10.0/24</remote_networks>
      <local_networks>10.10.0.0/24,10.10.10.0/24</local_networks>
      <data_ciphers>AES-256-GCM</data_ciphers>
      <data_ciphers_fallback>AES-256-GCM</data_ciphers_fallback>
      <digest>SHA256</digest>
      <tls_type>crypt</tls_type>
      <compression>none</compression>
    </openvpn-server>
  </openvpn>

  <!-- Unbound DNS resolver -->
  <unbound>
    <enable/>
    <active_interface>lan,opt1</active_interface>
    <outgoing_interface>wan</outgoing_interface>
    <system_domain_local_zone_type>transparent</system_domain_local_zone_type>
    <forwarding>0</forwarding>
  </unbound>

  <!-- Syslog remote vers Logstash Site A -->
  <syslog>
    <enable/>
    <remoteserver>10.10.0.30:5514</remoteserver>
    <filter>1</filter>
    <logfilesize>1048576</logfilesize>
  </syslog>
</pfsense>
