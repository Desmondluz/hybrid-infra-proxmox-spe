---
# ============================================================================
# GABARIT de secrets PROD (environnement Proxmox école) — FW3
# ----------------------------------------------------------------------------
# CECI EST UN MODÈLE EN CLAIR. Ne jamais committer la version remplie en clair.
#
# Procédure :
#   1. cp secrets/school-prod.enc.yml.example /tmp/school-prod.plain.yml
#   2. remplir toutes les valeurs <REMPLIR_...> ci-dessous
#   3. chiffrer :
#        sops --encrypt --age <CLE_PUBLIQUE_AGE> \
#          /tmp/school-prod.plain.yml > secrets/school-prod.enc.yml
#   4. détruire le clair :  shred -u /tmp/school-prod.plain.yml
#   5. vérifier :           sops -d secrets/school-prod.enc.yml | head
#
# La clé publique age se lit dans ~/.config/sops/age/keys.txt (ligne "public key:").
# Les destinataires sont déclarés dans .sops.yaml (path_regex secrets/.*).
# ============================================================================

# --- Proxmox (consommé par Terraform en prod) -------------------------------
# Token API du user terraform@pve créé en Phase 0. Format : "user@realm!tokenid=uuid".
proxmox_api_token: "terraform@pve!ci=<REMPLIR_UUID_TOKEN>"

# --- pfSense (API REST, rôles pfsense + openvpn + killswitch) ---------------
# Un token par firewall ; en pratique le même rôle déploie les deux.
pfsense_api_token: "<REMPLIR_TOKEN_API_PFSENSE>"

# --- OpenVPN PKI (rôle openvpn — bundle CA + cert/clé locaux) ----------------
# Coller le contenu PEM complet (en-tête BEGIN/END inclus) en bloc multi-lignes.
# (Placeholders volontairement non-PEM ici pour ne pas déclencher gitleaks.)
openvpn_ca_cert: "<REMPLIR_CA_PEM_COMPLET>"
openvpn_local_cert: "<REMPLIR_CERT_LOCAL_PEM_COMPLET>"
openvpn_local_key: "<REMPLIR_CLE_PRIVEE_PEM_COMPLET>"

# --- NetBox (rôle netbox) ----------------------------------------------------
netbox_secret_key: "<REMPLIR_50_CARACTERES_ALEATOIRES>"
netbox_admin_password: "<REMPLIR_MOT_DE_PASSE_FORT>"
netbox_admin_token: "<REMPLIR_TOKEN_API_NETBOX_40_HEX>"

# --- Elastic stack (rôles elasticsearch / kibana / logstash) -----------------
elastic_admin_password: "<REMPLIR_MOT_DE_PASSE_FORT>"
