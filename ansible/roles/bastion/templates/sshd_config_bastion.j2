# Managed by Ansible — role: bastion (SSH hardening + 2FA)

Port {{ bastion_wan_port | default(2222) }}
AddressFamily inet
Protocol 2

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey,keyboard-interactive
ChallengeResponseAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes

MaxAuthTries 3
MaxSessions 4
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

# TCP forwarding BLOQUÉ par défaut (mitige le pivot SSH via bastion).
# Exceptions nominatives ajoutées en fin de fichier via Match User
# (voir bastion_forward_users dans defaults/main.yml).
AllowTcpForwarding no
AllowAgentForwarding no
GatewayPorts no
X11Forwarding no
PermitUserEnvironment no
StrictModes yes

Banner /etc/issue.net
LogLevel VERBOSE
Subsystem sftp /usr/lib/openssh/sftp-server

AllowUsers {{ ssh_allow_users }}

# ============================================================================
# Exceptions forward TCP — utilisateurs nominativement autorisés
# Pattern bastion production : forward bloqué pour tous les utilisateurs SSH,
# exception accordée uniquement à l'opérateur infra qui a besoin du tunnel
# administratif (ex: tunnel SSH inverse Filebeat → Logstash collector).
# Variable : bastion_forward_users dans group_vars/<site>.yml ou defaults.
# ============================================================================
{% if bastion_forward_users | default([]) | length > 0 %}
{% for user in bastion_forward_users %}
Match User {{ user }}
    AllowTcpForwarding yes
    AllowAgentForwarding yes

{% endfor %}
{% endif %}
